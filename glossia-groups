  flex-wrap: nowrap;
  align-items: stretch;
  gap: 0;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 20px;
  overflow: hidden;
  background:
    linear-gradient(130deg, rgba(255, 107, 26, 0.12), rgba(255, 255, 255, 0.02)),
