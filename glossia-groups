}

/* ─ HERO BOX ─────────────────────────────────────────────────── */
.hero-box {
  padding: 10px;
  border-color: rgba(232,168,76,0.12);
}

.hero-box.is-inview {
  border-color: rgba(232,168,76,0.26);
  box-shadow: var(--sh-lg), 0 0 0 1px rgba(232,168,76,0.06);
}

.hero-placeholder {
  position: relative;
  overflow: hidden;
  min-height: clamp(280px, 52vw, 560px);
  border-radius: calc(var(--r-lg) - 4px);
  border: 1px dashed rgba(232,168,76,0.28);
  display: grid;
  place-content: center;
  text-align: center;
  gap: 10px;
  background:
    linear-gradient(158deg,
      rgba(232,168,76,0.08) 0%, rgba(200,136,42,0.03) 50%, transparent 100%),
    repeating-linear-gradient(135deg,
      rgba(255,255,255,0.012) 0, rgba(255,255,255,0.012) 1px,
      transparent 1px, transparent 22px);
}

.hero-box.is-inview .hero-placeholder {
  animation: hero-pan 18s ease-in-out infinite alternate;
}

@keyframes hero-pan {
  0%   { transform: scale(1)    translateX(0%);    filter: brightness(1);    }
  45%  { transform: scale(1.04) translateX(-1.8%); filter: brightness(1.02); }
  100% { transform: scale(1.09) translateX(1.8%);  filter: brightness(1.04); }
}

.hero-placeholder span   { font-size: 2.6rem; }
.hero-placeholder strong { font-family: "Changa", sans-serif; font-size: 1.35rem; color: var(--au-2); }
.hero-placeholder small  { color: var(--ink-3); font-size: 0.88rem; }

/* ─ TRUST + CTA ROW ──────────────────────────────────────────── */
.trust-cta-row {
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
  gap: 14px;
  align-items: stretch;
  width: min(980px, 100%);
  margin-inline-start: auto;
  margin-inline-end: 0;
}

/* ─ TRUST BLOCK ──────────────────────────────────────────────── */
.trust-block {
  padding: clamp(20px, 3.2vw, 38px);
  background:
    radial-gradient(ellipse 520px 300px at 88% 0%,
      rgba(232,168,76,0.09) 0%, transparent 58%),
    linear-gradient(158deg, var(--srf-1), var(--srf-0));
}

.trust-main .stars {
  display: block;
  margin-bottom: 12px;
  font-size: 1.14rem;
  letter-spacing: 0.07em;
  color: var(--au-1);
  text-shadow: 0 0 22px rgba(255,210,122,0.58);
  transform-origin: right center;
  transition:
    transform var(--t-lg) var(--ease-spring),
    text-shadow var(--t-lg) var(--ease-out);
}

.trust-main .stars.trust-zoomed {
  transform: scale(1.15);
  text-shadow: 0 0 38px rgba(255,210,122,0.88);
}

.trust-main h2 {
  font-family: "Changa", sans-serif;
  font-size: clamp(0.98rem, 1.7vw, 1.26rem);
  font-weight: 700;
  line-height: 1.40;
  color: var(--ink-1);
  transform-origin: right center;
  transition: transform var(--t-lg) var(--ease-spring);
}

.trust-main h2.trust-zoomed { transform: scale(1.15); }

.trust-main > p {
  margin-top: 12px;
  color: var(--ink-2);
  font-size: clamp(0.84rem, 1.3vw, 0.98rem);
  line-height: 1.70;
}

/* ─ CTA ZONE ─────────────────────────────────────────────────── */
.cta-zone {
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
  gap: 22px;
  padding: clamp(20px, 3.2vw, 38px);
  border-color: rgba(232,168,76,0.20);
  background:
    radial-gradient(ellipse 380px 220px at 50% 0%,
      rgba(232,168,76,0.08) 0%, transparent 58%),
    linear-gradient(172deg, rgba(16,13,9,0.99), rgba(8,8,6,0.99));
}

.cta-copy { text-align: right; }

.cta-copy h2, .product-copy h2 {
  font-family: "Changa", sans-serif;
  font-size: clamp(1rem, 1.9vw, 1.36rem);
  font-weight: 700;
  line-height: 1.34;
  color: var(--ink-1);
}

.cta-copy p, .product-copy p {
  margin-top: 9px;
  color: var(--ink-2);
  font-size: clamp(0.84rem, 1.2vw, 0.96rem);
}

/* ─ BUTTONS ──────────────────────────────────────────────────── */
.primary-btn,
.secondary-btn,
.close-btn {
  border: 0;
  cursor: pointer;
  font-family: inherit;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  appearance: none;
  -webkit-appearance: none;
}

.primary-btn {
  min-height: 52px;
  padding: 14px 32px;
  border-radius: var(--r-inf);
  font-size: 1rem;
  font-weight: 900;
  letter-spacing: 0.04em;
  color: #1C0E00;
  background: linear-gradient(135deg, var(--au-1) 0%, var(--au-2) 50%, var(--au-3) 100%);
  border: 1px solid rgba(255,210,122,0.52);
  box-shadow:
    0 8px 30px rgba(200,136,42,0.42),
    inset 0 1px 0 rgba(255,255,255,0.28);
  position: relative;
  overflow: hidden;
  transition:
    transform var(--t-md) var(--ease-spring),
    box-shadow var(--t-md) var(--ease-out),
    filter var(--t-sm) var(--ease-out);
}

/* Gold shimmer sweep on hover */
.primary-btn::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(108deg,
    transparent 36%, rgba(255,255,255,0.30) 50%, transparent 64%);
  transform: translateX(-110%);
  transition: transform 0.55s var(--ease-out);
}

.primary-btn:hover {
  transform: translateY(-3px) scale(1.025);
  box-shadow:
    0 0 0 4px rgba(232,168,76,0.22),
    0 18px 52px rgba(200,136,42,0.64),
    inset 0 1px 0 rgba(255,255,255,0.30);
  filter: brightness(1.08);
}

.primary-btn:hover::after { transform: translateX(110%); }
.primary-btn:active        { transform: translateY(-1px) scale(0.986); }
.primary-btn.block         { width: 100%; }

.secondary-btn {
  min-height: 48px;
  padding: 12px 28px;
  border-radius: var(--r-inf);
  font-size: 0.96rem;
  font-weight: 800;
  color: var(--au-2);
  border: 1px solid rgba(232,168,76,0.45);
  background: rgba(232,168,76,0.07);
  transition:
    transform var(--t-md) var(--ease-spring),
    background var(--t-md),
    box-shadow var(--t-md) var(--ease-out);
}

.secondary-btn:hover {
  transform: translateY(-2px);
  background: rgba(232,168,76,0.14);
  box-shadow: 0 8px 24px rgba(200,136,42,0.22);
}

.close-btn {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  color: var(--ink-2);
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--gb);
  font-size: 1rem;
  transition: background var(--t-sm), transform var(--t-sm) var(--ease-spring),
              color var(--t-sm), border-color var(--t-sm);
}

.close-btn:hover {
  background: rgba(248,113,113,0.14);
  border-color: rgba(248,113,113,0.30);
  color: var(--err);
  transform: rotate(90deg) scale(1.12);
}

.primary-btn:focus-visible,
.secondary-btn:focus-visible,
.close-btn:focus-visible,
.search-wrap button:focus-visible {
  outline: 2px solid var(--au-2);
  outline-offset: 3px;
}

#open-action {
  min-height: 50px;
  padding: 12px 26px;
  font-size: 0.96rem;
  align-self: flex-end;
}

/* ─ QUICK LIST ───────────────────────────────────────────────── */
.quick-list { padding: clamp(18px, 3.2vw, 32px); }

.quick-list h3 {
  font-family: "Changa", sans-serif;
  font-size: clamp(1rem, 1.9vw, 1.36rem);
  font-weight: 700;
  margin-bottom: 16px;
}

.chips { display: flex; flex-wrap: wrap; gap: 10px; }

.chips span {
  padding: 9px 17px;
  border-radius: var(--r-inf);
  border: 1px solid var(--gb);
  background: var(--glass);
  color: var(--ink-2);
  font-size: 0.9rem;
  cursor: default;
  transition:
    transform var(--t-md) var(--ease-spring),
    border-color var(--t-md), background var(--t-md),
    color var(--t-md), opacity var(--t-md), box-shadow var(--t-md);
}

.chips span.active {
  border-color: rgba(232,168,76,0.52);
  background: rgba(232,168,76,0.11);
  color: var(--au-1);
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(200,136,42,0.18);
}

.chips span.dim { opacity: 0.25; }

/* ─ FOOTER ───────────────────────────────────────────────────── */
.site-footer {
  margin-top: 14px;
  padding: clamp(18px, 3.2vw, 28px);
  border: 1px solid var(--gb);
  border-radius: var(--r-lg);
  background: linear-gradient(158deg, var(--srf-1), var(--srf-0));
  box-shadow: var(--sh-md);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
}

.site-footer strong {
  font-family: "Changa", sans-serif;
  font-size: 1.06rem;
  letter-spacing: 0.09em;
  background: linear-gradient(135deg, var(--au-1), var(--au-2));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.site-footer p   { margin-top: 8px; color: var(--ink-3); font-size: 0.88rem; }
.footer-meta     { display: grid; gap: 7px; color: var(--ink-3); font-size: 0.86rem; text-align: left; }

/* ─ OVERLAY ──────────────────────────────────────────────────── */
.overlay { position: fixed; inset: 0; z-index: 50; cursor: default; }

.overlay:not(.hidden) {
  animation: overlay-in var(--t-lg) var(--ease-out) forwards;
}

@keyframes overlay-in {
  from {
    background: rgba(0,0,0,0);
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
  }
  to {
    background: rgba(0,0,0,0.82);
    backdrop-filter: blur(12px) saturate(72%);
    -webkit-backdrop-filter: blur(12px) saturate(72%);
  }
}

/* ─ MODAL ────────────────────────────────────────────────────── */
.modal {
  position: fixed;
  inset: 50% auto auto 50%;
  transform: translate(-50%, -50%);
  z-index: 60;
  width: min(640px, calc(100% - 24px));
  max-height: 90dvh;
  overflow-y: auto;
  overflow-x: hidden;
  border-radius: var(--r-xl);
  border: 1px solid var(--gb-warm);
  background: linear-gradient(176deg, rgba(17,13,9,0.99) 0%, rgba(7,7,5,0.99) 100%);
  box-shadow: var(--sh-xl), 0 0 0 1px rgba(232,168,76,0.05);
  scrollbar-width: thin;
  scrollbar-color: rgba(232,168,76,0.22) transparent;
}

.modal:not(.hidden) {
  animation: modal-bloom var(--t-xl) var(--ease-spring) forwards;
}

@keyframes modal-bloom {
  0%   { transform: translate(-50%, -50%) scale(0.86); opacity: 0; }
  100% { transform: translate(-50%, -50%) scale(1);    opacity: 1; }
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 20px 24px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  position: sticky;
  top: 0;
  z-index: 2;
  background: linear-gradient(180deg, rgba(17,13,9,0.99) 0%, rgba(13,10,7,0.97) 100%);
  backdrop-filter: blur(16px);
}

.modal-head h2 {
  font-family: "Changa", sans-serif;
  font-size: 1.32rem;
  font-weight: 700;
}

.modal-body    { padding: 20px 24px; display: grid; gap: 16px; }
.action-switcher { gap: 20px; }

/* ─ TAB SWITCHER ─────────────────────────────────────────────── */
.switch-buttons {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 7px;
  padding: 5px;
  border-radius: var(--r-md);
  background: rgba(255,255,255,0.028);
  border: 1px solid var(--gb);
}

.tab-btn {
  border: 1px solid transparent;
  border-radius: calc(var(--r-md) - 2px);
  min-height: 46px;
  padding: 10px 14px;
  font-family: inherit;
  font-size: 0.96rem;
  font-weight: 800;
  color: var(--ink-3);
  background: transparent;
  cursor: pointer;
  appearance: none;
  transition: color var(--t-md), background var(--t-md), border-color var(--t-md), box-shadow var(--t-md);
}

.tab-btn.is-active {
  color: #1C0E00;
  background: linear-gradient(135deg, var(--au-1), var(--au-2));
  border-color: rgba(255,210,122,0.50);
  box-shadow: 0 4px 18px rgba(200,136,42,0.38);
}

.tab-panel {
  display: grid;
  gap: 14px;
  animation: panel-in var(--t-lg) var(--ease-spring);
}

@keyframes panel-in {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ─ BOOKING FORM ─────────────────────────────────────────────── */
.field-block { display: grid; gap: 10px; }

.field-title {
  font-size: 0.86rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  color: var(--ink-2);
}

.choice-group { display: flex; flex-wrap: wrap; gap: 8px; }

.choice-btn {
  min-height: 38px;
  padding: 7px 16px;
  border-radius: var(--r-inf);
  border: 1px solid var(--gb);
  background: var(--glass);
  color: var(--ink-2);
  font-family: inherit;
  font-size: 0.88rem;
  font-weight: 700;
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
  transition:
    transform var(--t-md) var(--ease-spring),
    border-color var(--t-md), background var(--t-md),
    color var(--t-md), box-shadow var(--t-md);
}

.choice-btn:hover {
  transform: translateY(-2px);
  border-color: rgba(232,168,76,0.42);
  color: var(--au-2);
}

.choice-btn.is-active {
  color: #1C0E00;
  background: linear-gradient(135deg, var(--au-1), var(--au-2));
  border-color: rgba(255,210,122,0.58);
  box-shadow: 0 4px 14px rgba(200,136,42,0.30);
  transform: translateY(-1px);
}

.menu-link-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 42px;
  padding: 10px 18px;
  border-radius: var(--r-sm);
  border: 1px solid rgba(232,168,76,0.34);
  background: rgba(232,168,76,0.07);
  color: var(--au-2);
  text-decoration: none;
  font-family: inherit;
  font-size: 0.9rem;
  font-weight: 800;
  width: fit-content;
  transition: background var(--t-md), border-color var(--t-md), transform var(--t-md) var(--ease-spring);
}

.menu-link-btn:hover {
  background: rgba(232,168,76,0.14);
  border-color: rgba(232,168,76,0.58);
  transform: translateY(-1px);
}

.selected-service-label {
  font-size: 0.86rem;
  color: var(--ink-3);
  transition: color var(--t-md);
}

.selected-service-label.has-value { color: var(--au-1); font-weight: 800; }

.modal-body label {
  display: grid;
  gap: 8px;
  font-size: 0.88rem;
  font-weight: 800;
  color: var(--ink-2);
}

.modal-body input,
.modal-body select,
.modal-body textarea {
  width: 100%;
  border: 1px solid var(--gb);
  border-radius: var(--r-sm);
  padding: 12px 14px;
  color: var(--ink-1);
  background: rgba(255,255,255,0.028);
  font-family: inherit;
  font-size: 0.96rem;
  direction: rtl;
  transition: border-color var(--t-md) var(--ease-out), box-shadow var(--t-md);
}

.modal-body input:focus,
.modal-body textarea:focus {
  outline: none;
  border-color: rgba(232,168,76,0.48);
  box-shadow: 0 0 0 3px rgba(232,168,76,0.10);
}

.form-error  { min-height: 22px; font-size: 0.88rem; font-weight: 700; color: var(--err); }
.form-success { min-height: 22px; font-size: 0.88rem; font-weight: 700; color: var(--ok); }

/* ─ PRODUCT SHOP ─────────────────────────────────────────────── */
.shop-intro {
  border: 1px solid var(--gb);
  border-radius: var(--r-sm);
  padding: 10px 14px;
  background: var(--glass);
}

.shop-intro p { color: var(--ink-3); font-size: 0.9rem; }

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 12px;
}

.product-card {
  border: 1px solid var(--gb);
  border-radius: var(--r-md);
  padding: 12px;
  background: linear-gradient(145deg, var(--srf-1), var(--srf-0));
  cursor: pointer;
  display: grid;
  gap: 10px;
  text-align: right;
  position: relative;
  overflow: hidden;
  color: inherit;
  appearance: none;
  -webkit-appearance: none;
  transition:
    transform var(--t-md) var(--ease-spring),
    border-color var(--t-md), box-shadow var(--t-md);
}

.product-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: transparent;
  transition: background var(--t-md);
  pointer-events: none;
}

.product-card:hover {
  transform: translateY(-4px) scale(1.012);
  border-color: rgba(232,168,76,0.38);
  box-shadow: 0 10px 32px rgba(200,136,42,0.22);
}

.product-card.is-selected {
  border-color: rgba(232,168,76,0.72);
  box-shadow: 0 0 0 2px rgba(232,168,76,0.18), 0 10px 32px rgba(200,136,42,0.32);
  transform: translateY(-2px);
}

.product-card.is-selected::before {
  background: linear-gradient(135deg, rgba(232,168,76,0.09) 0%, transparent 55%);
}

.product-card figure {
  margin: 0;
  min-height: 96px;
  border-radius: calc(var(--r-md) - 4px);
  border: 1px dashed rgba(232,168,76,0.33);
  display: grid;
  place-content: center;
  text-align: center;
  background: rgba(232,168,76,0.05);
  transition: border-color var(--t-md), background var(--t-md);
}

.product-card.is-selected figure {
  border-color: rgba(232,168,76,0.52);
  background: rgba(232,168,76,0.09);
}

.product-card figure small { color: var(--ink-3); font-size: 0.76rem; margin-top: 4px; }
.product-card strong       { font-family: "Changa", sans-serif; font-size: 0.98rem; }
.product-card p            { color: var(--ink-3); font-size: 0.82rem; line-height: 1.5; }
.product-card span         { color: var(--au-1); font-weight: 800; }

.product-tag {
  justify-self: start;
  padding: 4px 10px;
  border-radius: var(--r-inf);
  border: 1px solid rgba(232,168,76,0.33);
  color: var(--au-2);
  background: rgba(232,168,76,0.08);
  font-size: 0.72rem;
  font-weight: 800;
}

.shop-bottom-bar {
  position: sticky;
  bottom: 0;
  z-index: 2;
  border: 1px solid var(--gb-warm);
  border-radius: var(--r-md);
  padding: 12px 14px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  background: linear-gradient(162deg, rgba(16,12,8,0.99), rgba(9,8,5,0.99));
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-shadow: 0 -4px 24px rgba(0,0,0,0.45);
}

.shop-total-wrap span   { display: block; color: var(--ink-3); font-size: 0.82rem; }
.shop-total-wrap strong { display: block; font-family: "Changa", sans-serif; font-size: 1.2rem; color: var(--au-1); }

/* ─ UTILITIES ────────────────────────────────────────────────── */
.hidden { display: none !important; }

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  border: 0;
}

/* ─ TABLET ───────────────────────────────────────────────────── */
@media (max-width: 980px) {
  .trust-cta-row {
    grid-template-columns: 1fr;
    width: 100%;
    margin-inline: 0;
  }

  .cta-zone {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
  }
}

@media (max-width: 820px) {
  .site-footer { flex-direction: column; gap: 16px; }
}

/* ─ MOBILE ───────────────────────────────────────────────────── */
@media (max-width: 660px) {
  body { padding: 10px 12px 40px; }

  .site-header {
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    padding-bottom: 14px;
  }

  .search-wrap { max-width: 100%; }
  .page-shell  { gap: 10px; }
  .hero-placeholder { min-height: 210px; }
  .hero-box.is-inview .hero-placeholder { animation: none; }

  .trust-main .stars.trust-zoomed,
  .trust-main h2.trust-zoomed { transform: none; }

  .cta-zone { flex-direction: column; align-items: flex-start; }
  #open-action { width: 100%; align-self: stretch; }

  .product-grid { grid-template-columns: 1fr; }

  .shop-bottom-bar { flex-direction: column; align-items: stretch; gap: 10px; }
  .shop-bottom-bar .primary-btn { width: 100%; }

  .footer-meta { text-align: right; }
}

/* ─ REDUCED MOTION ───────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
