}

.secondary-btn {
  color: var(--text);
  border: 1px solid rgba(255, 148, 62, 0.74);
  background: linear-gradient(135deg, rgba(255, 148, 62, 0.22), rgba(255, 148, 62, 0.08));
  box-shadow: 0 0 0 3px rgba(255, 148, 62, 0.08);
}

.primary-btn:hover,
.secondary-btn:hover {
  transform: translateY(-2px);
