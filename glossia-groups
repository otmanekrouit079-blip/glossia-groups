  font-size: 1.35rem;
  font-weight: 800;
  color: #1c0b00;
  background: linear-gradient(140deg, var(--orange), var(--orange-2));
  box-shadow: 0 0 0 3px rgba(255, 148, 62, 0.15), 0 12px 22px rgba(0, 0, 0, 0.42);
}

.logo-text {
  display: grid;
  line-height: 1;
}

.logo-text strong {
  font-family: "Changa", sans-serif;
  font-size: 1.08rem;
  letter-spacing: 0.07em;
}

.logo-text small {
  color: var(--muted);
  letter-spacing: 0.26em;
  font-size: 0.62rem;
  margin-top: 3px;
}

.search-wrap {
  flex: 1;
  max-width: 520px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01));
}

.search-wrap input {
  flex: 1;
  border: 0;
  outline: 0;
  color: var(--text);
  background: transparent;
  font-size: 0.96rem;
  padding: 8px 12px;
}

.search-wrap button {
  border: 0;
  border-radius: 999px;
  padding: 10px 18px;
  font-weight: 800;
  color: #2a1201;
  background: linear-gradient(130deg, var(--orange), var(--orange-2));
  cursor: pointer;
}

.page-shell {
  display: grid;
  gap: 18px;
}

.trust-cta-row {
  display: grid;
  grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
  gap: 14px;
  align-items: stretch;
  width: min(980px, 100%);
  margin-inline-start: auto;
  margin-inline-end: 0;
  justify-self: end;
}

.tagline-block,
.hero-box,
.trust-block,
.cta-zone,
.product-zone,
.quick-list,
.site-footer {
  border: 1px solid var(--line);
