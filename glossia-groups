taskList.addEventListener("change", function (event) {
  const target = event.target;

  if (target.tagName !== "INPUT" || target.type !== "checkbox") {
    return;
  }

  const taskIndex = Number(target.dataset.taskIndex);
  if (Number.isNaN(taskIndex)) {
    return;
