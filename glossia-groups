  --orange-2: #ff8c42;
  --orange-soft: rgba(255, 107, 26, 0.14);
  --orange-line: rgba(255, 140, 66, 0.34);
  --shadow: 0 26px 80px rgba(0, 0, 0, 0.45);
  --radius: 24px;
}

* {
  box-sizing: border-box;
}

html {
  color-scheme: dark;
}

body {
  margin: 0;
  font-family: "Manrope", sans-serif;
  color: var(--text);
  background:
    radial-gradient(900px 480px at 20% 0%, rgba(255, 107, 26, 0.14), transparent 58%),
    radial-gradient(800px 420px at 100% 100%, rgba(255, 140, 66, 0.1), transparent 62%),
    var(--bg);
  overflow: hidden;
}

a,
button {
  color: inherit;
}

button,
input,
select {
  font: inherit;
}

img {
  max-width: 100%;
}

.skip-link {
  position: fixed;
  top: -44px;
  left: 18px;
  z-index: 300;
  padding: 10px 14px;
  border-radius: 999px;
  background: #ffffff;
  color: #111111;
  text-decoration: none;
}

.skip-link:focus {
  top: 18px;
}

.journey-progress {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 140;
  width: 100%;
  height: 3px;
  background: rgba(255, 255, 255, 0.06);
}

.journey-progress span {
  display: block;
  width: 0;
  height: 100%;
  background: linear-gradient(90deg, var(--orange), var(--orange-2));
  box-shadow: 0 0 18px rgba(255, 107, 26, 0.5);
}

.journey-dots {
  position: fixed;
  right: 18px;
  top: 50%;
  z-index: 130;
  display: flex;
  flex-direction: column;
  gap: 10px;
  transform: translateY(-50%);
}

.journey-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 12px;
  height: 12px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.18);
  cursor: pointer;
  transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
}

.journey-dot span {
  position: absolute;
  right: 20px;
  padding: 5px 9px;
  border-radius: 999px;
  background: rgba(10, 10, 10, 0.86);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--text);
  font-size: 0.7rem;
  opacity: 0;
  pointer-events: none;
  transform: translateX(8px);
  transition: opacity 0.18s ease, transform 0.18s ease;
  white-space: nowrap;
}

.journey-dot:hover span,
.journey-dot.is-active span {
  opacity: 1;
  transform: translateX(0);
}

.journey-dot.is-active {
  transform: scale(1.26);
  background: linear-gradient(135deg, var(--orange), var(--orange-2));
  box-shadow: 0 0 18px rgba(255, 107, 26, 0.55);
}

.journey {
  height: 100vh;
  display: flex;
  overflow-x: auto;
  overflow-y: hidden;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
}

.journey::-webkit-scrollbar {
  display: none;
}

.panel {
  position: relative;
  flex: 0 0 100vw;
  width: 100vw;
  height: 100vh;
  scroll-snap-align: start;
  overflow: hidden;
  border-right: 1px solid rgba(255, 255, 255, 0.04);
}

.panel::before {
  content: "";
