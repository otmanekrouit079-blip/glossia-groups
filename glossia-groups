  function setLanguage(lang) {
    const safeLang = translations[lang] ? lang : "fr";
    const dictionary = translations[safeLang];

    root.lang = safeLang;
    root.dir = safeLang === "ar" ? "rtl" : "ltr";
    body.classList.toggle("is-rtl", safeLang === "ar");

    document.title = dictionary.page_title;
    if (metaDescription) {
      metaDescription.setAttribute("content", dictionary.meta_description);
    }

    document.querySelectorAll("[data-i18n]").forEach(function (element) {
      const key = element.getAttribute("data-i18n");
      if (key && Object.prototype.hasOwnProperty.call(dictionary, key)) {
        element.textContent = dictionary[key];
      }
    });

    document.querySelectorAll("[data-i18n-placeholder]").forEach(function (element) {
      const key = element.getAttribute("data-i18n-placeholder");
      if (key && Object.prototype.hasOwnProperty.call(dictionary, key)) {
        element.setAttribute("placeholder", dictionary[key]);
      }
    });

    langButtons.forEach(function (button) {
      const isActive = button.getAttribute("data-lang") === safeLang;
      button.classList.toggle("is-active", isActive);
      button.setAttribute("aria-pressed", isActive ? "true" : "false");
    });

    window.localStorage.setItem(STORAGE_KEY, safeLang);
  }

  const savedLanguage = window.localStorage.getItem(STORAGE_KEY) || "fr";

  langButtons.forEach(function (button) {
    button.addEventListener("click", function () {
      const nextLang = button.getAttribute("data-lang") || "fr";
      setLanguage(nextLang);
    });
  });

  setLanguage(savedLanguage);

  let activePanelIndex = 0;
  let activeCarouselIndex = 0;
  let carouselTimer = null;
  let targetScrollLeft = journey ? journey.scrollLeft : 0;
  let rafId = 0;

  function clamp(value, min, max) {
    return Math.max(min, Math.min(max, value));
  }

  function animateScroll() {
    if (!journey) {
      return;
    }

    const current = journey.scrollLeft;
    const next = current + (targetScrollLeft - current) * 0.14;

    if (Math.abs(targetScrollLeft - current) < 0.6) {
      journey.scrollLeft = targetScrollLeft;
      rafId = 0;
      return;
    }

    journey.scrollLeft = next;
    rafId = window.requestAnimationFrame(animateScroll);
  }

  function scrollToPanel(id) {
    const panel = document.getElementById(id);
    if (!journey || !panel) {
      return;
    }

    targetScrollLeft = panel.offsetLeft;

    if (prefersReducedMotion) {
      journey.scrollLeft = targetScrollLeft;
      return;
    }

    if (!rafId) {
      rafId = window.requestAnimationFrame(animateScroll);
    }
  }

  function updateProgress() {
    if (!journey || !progressBar) {
      return;
    }

    const maxScroll = journey.scrollWidth - journey.clientWidth;
    const progress = maxScroll <= 0 ? 0 : journey.scrollLeft / maxScroll;
    progressBar.style.width = progress * 100 + "%";

    const viewportCenter = journey.scrollLeft + journey.clientWidth / 2;
    let nearestIndex = 0;
    let nearestDistance = Number.POSITIVE_INFINITY;

    panels.forEach(function (panel, index) {
      const panelCenter = panel.offsetLeft + panel.offsetWidth / 2;
      const distance = Math.abs(panelCenter - viewportCenter);
      if (distance < nearestDistance) {
        nearestDistance = distance;
        nearestIndex = index;
      }
    });

    activePanelIndex = nearestIndex;

    dots.forEach(function (dot, index) {
      dot.classList.toggle("is-active", index === activePanelIndex);
    });
  }

  function animateCount(element) {
    const target = Number(element.getAttribute("data-countup") || "0");
    const decimals = Number(element.getAttribute("data-decimals") || "0");
    const duration = 1400;
    const startedAt = performance.now();

    function frame(now) {
      const progress = Math.min((now - startedAt) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = target * eased;
      element.textContent = decimals > 0 ? current.toFixed(decimals) : Math.round(current).toString();

      if (progress < 1) {
        requestAnimationFrame(frame);
      }
    }

    requestAnimationFrame(frame);
  }

  if (journey) {
    const revealObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) {
          return;
        }

        entry.target.classList.add("in-view");
        revealObserver.unobserve(entry.target);
      });
    }, {
      root: journey,
      threshold: 0.18
    });

    revealElements.forEach(function (element) {
      revealObserver.observe(element);
    });

    const countObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) {
          return;
        }

        animateCount(entry.target);
        countObserver.unobserve(entry.target);
      });
    }, {
      root: journey,
      threshold: 0.5
    });

    countupElements.forEach(function (element) {
      countObserver.observe(element);
    });
  }

  function showSlide(index) {
    if (!slides.length) {
      return;
    }

    activeCarouselIndex = (index + slides.length) % slides.length;
    slides.forEach(function (slide, slideIndex) {
      slide.classList.toggle("is-active", slideIndex === activeCarouselIndex);
    });
  }

  function restartCarousel() {
    if (!slides.length) {
      return;
    }

    window.clearInterval(carouselTimer);
    carouselTimer = window.setInterval(function () {
      showSlide(activeCarouselIndex + 1);
    }, 4300);
  }

  if (prevButton) {
    prevButton.addEventListener("click", function () {
      showSlide(activeCarouselIndex - 1);
      restartCarousel();
    });
  }

  if (nextButton) {
    nextButton.addEventListener("click", function () {
      showSlide(activeCarouselIndex + 1);
      restartCarousel();
    });
  }

  if (slides.length) {
    showSlide(0);
    restartCarousel();
  }

  dots.forEach(function (dot) {
    dot.addEventListener("click", function () {
      const target = dot.getAttribute("data-target");
      if (target) {
        scrollToPanel(target);
      }
    });
  });

  scrollTriggers.forEach(function (trigger) {
    trigger.addEventListener("click", function (event) {
      const target = trigger.getAttribute("data-scroll-to");
      if (!target) {
        return;
      }

      event.preventDefault();
      scrollToPanel(target);
    });
  });

  if (journey) {
    journey.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();

    if (useWheelHijack) {
      journey.addEventListener("wheel", function (event) {
        if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) {
          return;
        }

        event.preventDefault();
        const maxScroll = journey.scrollWidth - journey.clientWidth;
        const isRtl = root.dir === "rtl";
        const delta = isRtl ? -event.deltaY : event.deltaY;
        targetScrollLeft = clamp(targetScrollLeft + delta, 0, maxScroll);

        if (!rafId) {
          rafId = window.requestAnimationFrame(animateScroll);
        }
      }, { passive: false });
    }
  }

  window.addEventListener("keydown", function (event) {
    if (!journey || window.innerWidth <= 720) {
      return;
    }

    if (event.key === "ArrowRight") {
      scrollToPanel(panels[Math.min(activePanelIndex + 1, panels.length - 1)].id);
    }

    if (event.key === "ArrowLeft") {
      scrollToPanel(panels[Math.max(activePanelIndex - 1, 0)].id);
    }
  });

  window.requestAnimationFrame(function () {
    body.classList.add("is-loaded");
  });
})();

