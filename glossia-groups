function getOwnerObjectiveTopStatus(period, summary) {
  const targets = getOwnerCampaignTargets();
  const labelMap = {
    day: "Objectif Jour",
    week: "Objectif Semaine",
    month: "Objectif Mois"
  };

  if (!targets) {
    return {
      className: "danger",
      label: labelMap[period] || "Objectif",
      value: "Non défini"
    };
  }

  const target = period === "day"
    ? targets.dailyTarget
    : period === "week"
      ? targets.weekTarget
      : targets.monthTarget;
  const achieved = period === "day"
    ? summary.todaySales
    : period === "week"
      ? summary.weekSales
      : summary.monthSales;

  if (!Number.isFinite(target) || target <= 0) {
    return {
      className: "danger",
      label: labelMap[period] || "Objectif",
      value: "Non défini"
    };
  }

  const ratio = achieved / target;
  let className = "danger";

  if (ratio >= 1.9) {
    className = "gold";
  } else if (ratio >= 1.5) {
    className = "success";
  } else if (ratio >= 1) {
    className = "warning";
  }

  return {
    className: className,
    label: labelMap[period] || "Objectif",
    value: (ratio * 100).toFixed(1) + "%"
  };
}

