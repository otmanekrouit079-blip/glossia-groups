  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.service-topline h3 {
  margin: 0;
  font-size: 1.12rem;
}

.service-topline span {
  color: var(--orange-2);
  font-weight: 800;
}

.transform-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.transform-card {
  padding: 16px;
  border-radius: var(--radius);
}

.transform-pair {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.transform-photo {
  position: relative;
  aspect-ratio: 4 / 5;
}

.badge-label {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 2;
  padding: 5px 10px;
  border-radius: 999px;
  background: rgba(10, 10, 10, 0.76);
  color: #ffffff;
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.why-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.why-card {
  padding: 22px;
  border-radius: var(--radius);
}

.why-icon {
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  margin-bottom: 16px;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(255, 107, 26, 0.18), rgba(255, 140, 66, 0.08));
  color: var(--orange-2);
  font-size: 1.28rem;
}

.why-card h3 {
  margin: 0 0 8px;
}

.testimonial-carousel {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 16px;
  align-items: center;
}

.carousel-nav {
  width: 48px;
  height: 48px;
  margin: 0;
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 50%;
  background: rgba(255,255,255,0.05);
  color: var(--text);
  cursor: pointer;
}

.testimonial-track {
  position: relative;
  min-height: 278px;
}

.testimonial-card {
  position: absolute;
  inset: 0;
  padding: 28px;
  border-radius: var(--radius);
  opacity: 0;
  transform: translateX(28px);
  pointer-events: none;
  transition: opacity 0.34s ease, transform 0.34s ease;
}

.testimonial-card.is-active {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
}

.avatar-placeholder {
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  margin-bottom: 14px;
  border-radius: 50%;
  color: #180a00;
  background: linear-gradient(135deg, var(--orange), var(--orange-2));
  font-weight: 800;
}

.testimonial-card strong,
.testimonial-card span {
  display: block;
}

.testimonial-card span {
  margin-top: 6px;
  color: var(--orange-2);
}

.gallery-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.gallery-photo {
  aspect-ratio: 1 / 1;
}

.booking-inner {
  grid-template-columns: minmax(0, 0.96fr) minmax(360px, 0.84fr);
  align-items: center;
}

.booking-copy h2,
.final-cta h2 {
  margin: 0;
  font-family: "Syne", sans-serif;
  font-size: clamp(2.2rem, 3.6vw, 3.3rem);
  line-height: 1.03;
}

.availability-pill {
  display: inline-flex;
  padding: 10px 14px;
  border-radius: 999px;
  border: 1px solid var(--orange-line);
  background: var(--orange-soft);
  color: #ffd7b8;
}

.booking-form {
  padding: 22px;
  border-radius: var(--radius);
  display: grid;
  gap: 12px;
}

.booking-form label {
  display: grid;
  gap: 6px;
}

.booking-form span {
  font-weight: 700;
  color: #f3efe9;
}

.booking-form input,
.booking-form select {
  width: 100%;
  padding: 14px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.12);
  background: rgba(8, 8, 8, 0.84);
  color: var(--text);
}

.location-grid {
  grid-template-columns: minmax(320px, 0.56fr) minmax(0, 1fr);
}

.contact-card {
  padding: 22px;
  border-radius: var(--radius);
}

.contact-card ul {
  padding-left: 18px;
}

.map-placeholder {
  min-height: 320px;
}

.final-panel-inner {
  justify-content: center;
}

.final-cta {
  padding: 26px;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 20px;
}

.final-cta p:last-child {
  color: var(--muted);
}

.footer {
  padding-top: 8px;
  border-top: 1px solid rgba(255,255,255,0.08);
}

.footer-grid {
  grid-template-columns: 1.3fr 0.8fr 0.8fr;
}

.footer-links,
.social-row {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 8px;
  color: var(--muted);
}

.footer-copy {
  margin: 18px 0 0;
  color: var(--muted);
  font-size: 0.88rem;
}

.image-placeholder {
  display: grid;
  place-items: center;
  gap: 8px;
  padding: 24px;
  border-radius: 18px;
  border: 1px dashed var(--orange-line);
  background: linear-gradient(145deg, rgba(34, 22, 14, 0.68), rgba(15, 15, 15, 0.94));
  text-align: center;
  color: var(--text);
}

.placeholder-icon {
  font-size: 1.45rem;
}

.image-placeholder strong {
  font-size: 1rem;
}

.reveal {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}

.reveal.in-view {
  opacity: 1;
  transform: translateY(0);
}

.reveal-delay-1 {
  transition-delay: 0.08s;
}

.reveal-delay-2 {
  transition-delay: 0.16s;
}

.reveal-delay-3 {
  transition-delay: 0.24s;
}

.hero-load {
  opacity: 0;
  transform: translateY(36px) scale(0.98);
  transition: opacity 0.85s ease, transform 0.85s ease;
}

.landing-page.is-loaded .hero-load {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.hero-load-1 {
  transition-delay: 0.08s;
}

.hero-load-2 {
  transition-delay: 0.18s;
}

.hero-load-3 {
  transition-delay: 0.28s;
}

.hero-load-4 {
  transition-delay: 0.38s;
}

.hero-load-5 {
  transition-delay: 0.48s;
}

.hero-load-6 {
  transition-delay: 0.58s;
}

.mobile-booking-cta {
  position: fixed;
  left: 50%;
  bottom: 14px;
  z-index: 120;
  min-width: 180px;
  padding: 14px 18px;
  border-radius: 999px;
  color: #180a00;
  background: linear-gradient(135deg, var(--orange), var(--orange-2));
  transform: translateX(-50%);
  box-shadow: 0 16px 32px -18px rgba(255, 107, 26, 0.9);
  text-align: center;
  text-decoration: none;
}

.landing-page.is-rtl {
  direction: rtl;
}

.landing-page.is-rtl .journey-dots {
  left: 18px;
  right: auto;
}

.landing-page.is-rtl .journey-dot span {
  left: 20px;
  right: auto;
  transform: translateX(-8px);
}

.landing-page.is-rtl .journey-dot:hover span,
.landing-page.is-rtl .journey-dot.is-active span {
  transform: translateX(0);
}

.landing-page.is-rtl .topbar,
.landing-page.is-rtl .hero-grid,
.landing-page.is-rtl .booking-inner,
.landing-page.is-rtl .location-grid,
.landing-page.is-rtl .final-cta,
.landing-page.is-rtl .service-topline {
  direction: rtl;
}

.landing-page.is-rtl .hero-copy,
.landing-page.is-rtl .section-heading,
.landing-page.is-rtl .proof-story,
.landing-page.is-rtl .why-card,
.landing-page.is-rtl .service-body,
.landing-page.is-rtl .booking-copy,
.landing-page.is-rtl .booking-form,
.landing-page.is-rtl .contact-card,
.landing-page.is-rtl .testimonial-card,
.landing-page.is-rtl .footer {
  text-align: right;
}

.landing-page.is-rtl .hero-actions,
.landing-page.is-rtl .topbar-links {
  flex-direction: row-reverse;
}

.landing-page.is-rtl .contact-card ul {
  padding-right: 18px;
  padding-left: 0;
}

@keyframes pulseGlow {
  0%,
  100% {
    box-shadow: 0 18px 36px -18px rgba(255, 107, 26, 0.95);
  }
  50% {
    box-shadow: 0 22px 44px -14px rgba(255, 140, 66, 1);
  }
}

@media (prefers-reduced-motion: reduce) {
  html,
  .journey {
    scroll-behavior: auto;
  }

  .pulse-glow,
  .hero-load,
  .reveal,
  .journey-dot,
  .button,
  .service-card,
  .service-photo {
    animation: none !important;
    transition: none !important;
  }
}

@media (max-width: 1100px) {
  .hero-grid,
  .booking-inner,
  .location-grid,
  .footer-grid,
  .transform-grid,
  .why-grid {
    grid-template-columns: 1fr;
  }

  .services-grid,
  .gallery-grid,
  .trust-ribbon {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero-copy h1 {
    max-width: 11ch;
  }
}

@media (max-width: 820px) {
  body {
    overflow: auto;
  }

  .journey {
    scroll-snap-type: x mandatory;
  }

  .journey-dots {
    right: 10px;
  }

  .topbar {
    top: 18px;
  }

  .topbar-links {
    display: none;
  }

  .panel-inner {
    width: min(100vw - 28px, 1180px);
    padding-top: 70px;
  }
}

@media (max-width: 720px) {
  .journey-dots {
    display: none;
  }

  .panel {
    height: auto;
    min-height: 100vh;
  }

  .journey {
    height: auto;
    min-height: 100vh;
  }

  .panel-inner {
    height: auto;
    min-height: 100vh;
    justify-content: center;
    padding: 84px 0 88px;
  }

  .services-grid,
  .gallery-grid,
  .trust-ribbon,
  .transform-pair {
    grid-template-columns: 1fr;
  }

  .hero-actions,
  .final-cta,
  .topbar {
    flex-direction: column;
    align-items: stretch;
  }

  .hero-copy h1 {
    max-width: 11ch;
    font-size: clamp(2.8rem, 12vw, 4.4rem);
  }

  .testimonial-carousel {
    grid-template-columns: 1fr;
  }

  .carousel-nav {
    display: none;
  }

  .testimonial-track {
    min-height: 330px;
  }
}

