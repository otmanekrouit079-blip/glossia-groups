  line-height: 1.55;
  padding: 18px;
}

.bg-glow {
  position: fixed;
  z-index: -1;
  border-radius: 999px;
  filter: blur(16px);
  pointer-events: none;
}

.bg-glow-a {
  width: min(48vw, 620px);
  height: min(48vw, 620px);
  top: -180px;
  right: -140px;
  background: radial-gradient(circle, rgba(255, 107, 26, 0.24), transparent 70%);
}

.bg-glow-b {
  width: min(40vw, 520px);
  height: min(40vw, 520px);
  bottom: -170px;
  left: -120px;
  background: radial-gradient(circle, rgba(255, 148, 62, 0.2), transparent 74%);
}

.site-header,
.page-shell,
.site-footer {
  width: min(1150px, 100%);
  margin: 0 auto;
}

.site-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 10px 0 16px;
}

.logo-wrap {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: inherit;
}

