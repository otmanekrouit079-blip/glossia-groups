const confirmOrderBtn = document.getElementById("confirm-order");

const quickSearch = document.getElementById("quick-search");
const searchForm = quickSearch ? quickSearch.closest("form") : null;
const chipItems = Array.from(document.querySelectorAll("#search-results span"));

const products = [
  { id: "wax", name: "واكس التصفيف", price: 120, desc: "تثبيت نقي بلا ما يثقل الشعر", tag: "Top" },
  { id: "serum", name: "سيروم الذقن", price: 140, desc: "ترطيب ولمعة راقية للذقن", tag: "Premium" },
  { id: "shampoo", name: "شامبو مقوي", price: 95, desc: "تنقية يومية وريحة منعشة", tag: "Best Seller" },
  { id: "mask", name: "ماسك العناية", price: 160, desc: "عناية عميقة وترميم سريع", tag: "Expert" },
  { id: "spray", name: "سبراي التثبيت", price: 110, desc: "لوك منظم كيصبر معاك نهار كامل", tag: "New" },
  { id: "oil", name: "زيت التغذية", price: 130, desc: "نعومة وحماية ضد الجفاف", tag: "Care" }
];

let selectedProductIds = new Set();

function updateSelectedServiceLabel() {
  const serviceInput = document.getElementById("booking-service");
  const value = serviceInput.value.trim();

  if (value) {
    selectedServiceLabel.textContent = `الخدمة المختارة: ${value}`;
    selectedServiceLabel.classList.add("has-value");
  } else {
    selectedServiceLabel.textContent = "مازال ما تختارات حتى خدمة";
    selectedServiceLabel.classList.remove("has-value");
  }
}

function pickChoice(buttons, inputId, dataKey) {
  buttons.forEach((btn) => {
    btn.classList.remove("is-active");
  });

  const targetInput = document.getElementById(inputId);

  return function (button) {
    const value = button.getAttribute(dataKey) || "";
    targetInput.value = value;
    buttons.forEach((btn) => btn.classList.remove("is-active"));
    button.classList.add("is-active");
  };
}

function phoneIsValid(value) {
  const normalized = value.replace(/\s|-/g, "");
  return /^(\+212|0)(5|6|7)\d{8}$/.test(normalized);
}

function openModal(modalEl) {
  overlay.classList.remove("hidden");
  modalEl.classList.remove("hidden");
  overlay.setAttribute("aria-hidden", "false");
  document.body.style.overflow = "hidden";
}

function closeModal(modalEl) {
  modalEl.classList.add("hidden");

  if (actionModal.classList.contains("hidden")) {
    overlay.classList.add("hidden");
    overlay.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }
}

function showBookingTab() {
  tabBooking.classList.add("is-active");
  tabProducts.classList.remove("is-active");
  bookingPanel.classList.remove("hidden");
  productsPanel.classList.add("hidden");
}

function showProductsTab() {
  tabProducts.classList.add("is-active");
  tabBooking.classList.remove("is-active");
  productsPanel.classList.remove("hidden");
  bookingPanel.classList.add("hidden");
}

function resetBookingState() {
  bookingError.textContent = "";
  bookingSuccess.textContent = "";
}

function resetProductState() {
  productsError.textContent = "";
  productsSuccess.textContent = "";
}

function resetActionModalState() {
  showBookingTab();
  resetBookingState();
  resetProductState();
  updateSelectedServiceLabel();
}

function calculateTotal() {
  return products
    .filter((item) => selectedProductIds.has(item.id))
    .reduce((sum, item) => sum + item.price, 0);
}

function refreshTotal() {
  const total = calculateTotal();
  productsTotal.textContent = `${total} درهم`;

  const count = selectedProductIds.size;
  productsCount.textContent = `${count} منتوج مختار`;
}

function renderProducts() {
  const cards = products
    .map((product) => {
      const selectedClass = selectedProductIds.has(product.id) ? "is-selected" : "";

      return `
        <button type="button" class="product-card ${selectedClass}" data-product-id="${product.id}">
          <figure>
            <div>📦 صورة منتوج</div>
            <small>placeholder</small>
          </figure>
          <div class="product-tag">${product.tag}</div>
          <strong>${product.name}</strong>
          <p>${product.desc}</p>
          <span>${product.price} درهم</span>
        </button>
      `;
    })
    .join("");

  productGrid.innerHTML = cards;
}

function toggleProductSelection(productId) {
  if (selectedProductIds.has(productId)) {
    selectedProductIds.delete(productId);
  } else {
    selectedProductIds.add(productId);
  }

  renderProducts();
  refreshTotal();
}

function clearProductSelection() {
  selectedProductIds = new Set();
  renderProducts();
  refreshTotal();
}

function highlightSearch(query) {
  const term = query.trim();

  if (!term) {
    chipItems.forEach((chip) => {
      chip.classList.remove("active", "dim");
    });
    return;
  }

  chipItems.forEach((chip) => {
    const text = chip.textContent || "";
    const keywords = chip.getAttribute("data-keywords") || "";
    const hay = `${text} ${keywords}`;
    const match = hay.includes(term);

    chip.classList.toggle("active", match);
    chip.classList.toggle("dim", !match);
  });
}

openActionBtn.addEventListener("click", () => {
  const savedService = localStorage.getItem("glossiaSelectedService") || "";
  document.getElementById("booking-service").value = savedService;
  resetActionModalState();
  openModal(actionModal);
});

const onDayPick = pickChoice(dayChoices, "booking-day", "data-day");
const onTimePick = pickChoice(timeChoices, "booking-time", "data-time");

dayChoices.forEach((button) => {
  button.addEventListener("click", () => onDayPick(button));
});

timeChoices.forEach((button) => {
  button.addEventListener("click", () => onTimePick(button));
});

tabBooking.addEventListener("click", showBookingTab);
tabProducts.addEventListener("click", showProductsTab);

overlay.addEventListener("click", () => {
  closeModal(actionModal);
});

document.querySelectorAll("[data-close]").forEach((button) => {
  button.addEventListener("click", () => {
    const targetId = button.getAttribute("data-close");
    const targetModal = document.getElementById(targetId);
    if (targetModal) {
      closeModal(targetModal);
    }
  });
});

bookingForm.addEventListener("submit", (event) => {
  event.preventDefault();
  resetBookingState();

  const day = document.getElementById("booking-day").value.trim();
  const time = document.getElementById("booking-time").value.trim();
  const service = document.getElementById("booking-service").value.trim();
  const phone = document.getElementById("booking-phone").value.trim();

  if (!day || !time || !service || !phone) {
    bookingError.textContent = "اختار النهار والوقت والخدمة وكمل رقم الهاتف.";
    return;
  }

  if (!phoneIsValid(phone)) {
    bookingError.textContent = "دخل رقم هاتف مغربي صحيح بحال 06XXXXXXXX ولا +2126XXXXXXXX.";
    return;
  }

  bookingSuccess.textContent = "تسجل الحجز ديالك بنجاح. غادي نتاصلو بيك قريب.";
  bookingForm.reset();
  document.getElementById("booking-day").value = "";
  document.getElementById("booking-time").value = "";
  document.getElementById("booking-service").value = "";
  dayChoices.forEach((btn) => btn.classList.remove("is-active"));
  timeChoices.forEach((btn) => btn.classList.remove("is-active"));
  localStorage.removeItem("glossiaSelectedService");
  updateSelectedServiceLabel();

  setTimeout(() => {
    closeModal(actionModal);
    resetActionModalState();
  }, 1000);
});

confirmOrderBtn.addEventListener("click", () => {
  resetProductState();

  if (selectedProductIds.size === 0) {
    productsError.textContent = "اختار على الأقل منتوج واحد قبل تأكيد الطلب.";
    return;
  }

  productsSuccess.textContent = "تأكد الطلب ديالك بنجاح. رجعناك للصفحة الرئيسية.";
  clearProductSelection();

  setTimeout(() => {
    closeModal(actionModal);
    resetActionModalState();
  }, 1000);
});

productGrid.addEventListener("click", (event) => {
  const card = event.target.closest("[data-product-id]");
  if (!card) {
    return;
  }

  const productId = card.getAttribute("data-product-id");
  if (productId) {
    toggleProductSelection(productId);
  }
});

if (searchForm) {
  searchForm.addEventListener("submit", (event) => {
    event.preventDefault();
    highlightSearch(quickSearch.value);
  });
}

if (quickSearch) {
  quickSearch.addEventListener("input", () => {
    highlightSearch(quickSearch.value);
  });
}

document.addEventListener("keydown", (event) => {
  if (event.key === "Escape") {
    closeModal(actionModal);
  }
});

const panoramaTargets = Array.from(
  document.querySelectorAll(".hero-box, .trust-block, .cta-zone, .quick-list")
);
const trustBlock = document.querySelector(".trust-block");
const trustStars = document.querySelector(".trust-main .stars");
const trustHeading = document.querySelector(".trust-main h2");
let trustPulseTimer = null;
let trustPulseLastAt = 0;

function triggerTrustPulse() {
  if (!trustBlock || !trustStars || !trustHeading) {
    return;
  }

  const now = Date.now();
  if (now - trustPulseLastAt < 13000) {
    return;
  }
  trustPulseLastAt = now;

  if (trustPulseTimer) {
    clearTimeout(trustPulseTimer);
    trustPulseTimer = null;
  }

  trustStars.classList.remove("trust-zoomed");
  trustHeading.classList.remove("trust-zoomed");
  void trustStars.offsetWidth;

  trustStars.classList.add("trust-zoomed");
  trustHeading.classList.add("trust-zoomed");

  trustPulseTimer = setTimeout(() => {
    trustStars.classList.remove("trust-zoomed");
    trustHeading.classList.remove("trust-zoomed");
    trustPulseTimer = null;
  }, 12000);
}

function applyPanoramaState() {
  const viewportHeight = window.innerHeight || document.documentElement.clientHeight;

  panoramaTargets.forEach((section) => {
    const rect = section.getBoundingClientRect();
    const visibleHeight = Math.min(rect.bottom, viewportHeight) - Math.max(rect.top, 0);
    const ratio = Math.max(0, visibleHeight) / Math.max(1, rect.height);

    if (ratio >= 0.25) {
      section.classList.add("is-inview");

      if (section.classList.contains("trust-block")) {
        triggerTrustPulse();
      }
    } else {
      section.classList.remove("is-inview");
    }
  });
}

if ("IntersectionObserver" in window) {
  const panoramicObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-inview");
        } else {
          entry.target.classList.remove("is-inview");
        }
      });
    },
    {
      threshold: 0.45,
      rootMargin: "0px 0px -8% 0px"
    }
  );

  panoramaTargets.forEach((section) => panoramicObserver.observe(section));
}

window.addEventListener("scroll", applyPanoramaState, { passive: true });
window.addEventListener("resize", applyPanoramaState);

renderProducts();
refreshTotal();
updateSelectedServiceLabel();
applyPanoramaState();

