  top: 18%;
  left: 0;
  width: 1px;
  height: 64%;
  background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.22), transparent);
}

.trust-metrics strong {
  display: block;
  color: #ffd39c;
  font-family: "Changa", sans-serif;
  font-size: clamp(1.32rem, 2.8vw, 2rem);
  letter-spacing: 0.02em;
  line-height: 1.1;
  margin-bottom: 6px;
  text-shadow: 0 0 24px rgba(255, 148, 62, 0.26);
}

.trust-metrics span {
  display: block;
  color: #efe2d0;
  font-size: clamp(0.9rem, 1.2vw, 1.02rem);
  font-weight: 700;
}

.cta-zone,
.product-zone {
  padding: clamp(10px, 1.9vw, 14px);
