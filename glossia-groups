}

.quick-list {
  padding: clamp(16px, 3vw, 24px);
}

.quick-list h3 {
  margin: 0;
  font-family: "Changa", sans-serif;
  font-size: 1.16rem;
}

.chips {
  margin-top: 12px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.chips span {
  padding: 8px 12px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  background: rgba(255, 255, 255, 0.04);
  transition: transform 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
}

.chips span.active {
  border-color: rgba(255, 148, 62, 0.65);
  background: rgba(255, 107, 26, 0.18);
  transform: translateY(-1px);
}

.chips span.dim {
  opacity: 0.35;
}

.site-footer {
  margin-top: 18px;
  padding: 18px;
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.site-footer strong {
  font-family: "Changa", sans-serif;
  letter-spacing: 0.04em;
}

.site-footer p {
  margin: 8px 0 0;
  color: var(--muted);
}

.footer-meta {
  display: grid;
  gap: 8px;
  color: var(--muted);
  text-align: left;
}

.overlay {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(2px);
}

.modal {
  position: fixed;
  z-index: 60;
  inset: 50% auto auto 50%;
  transform: translate(-50%, -50%);
  width: min(620px, calc(100% - 28px));
  max-height: 88vh;
  overflow: auto;
  border-radius: 22px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  background: linear-gradient(165deg, rgba(20, 20, 20, 0.98), rgba(9, 9, 9, 0.99));
  box-shadow: 0 32px 70px rgba(0, 0, 0, 0.6);
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 16px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.modal-head h2 {
  margin: 0;
  font-family: "Changa", sans-serif;
  font-size: 1.22rem;
}

.close-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  color: var(--text);
  background: rgba(255, 255, 255, 0.08);
}

.modal-body {
  padding: 16px;
  display: grid;
  gap: 12px;
}

.action-switcher {
  gap: 14px;
}

.switch-buttons {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.tab-btn {
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 999px;
  min-height: 46px;
  padding: 10px 14px;
  font-family: inherit;
  font-weight: 800;
  color: var(--text);
  background: rgba(255, 255, 255, 0.04);
  cursor: pointer;
}

.tab-btn.is-active {
  color: #2a1201;
  border-color: rgba(255, 205, 160, 0.7);
  background: linear-gradient(130deg, var(--orange), var(--orange-2));
}

.tab-panel {
  display: grid;
  gap: 12px;
}

.field-block {
  display: grid;
  gap: 8px;
}

.field-title {
  font-size: 0.9rem;
  font-weight: 800;
  color: #e8dccf;
}

.choice-group {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.choice-btn {
  min-height: 36px;
  padding: 6px 12px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.04);
  color: #f2ece4;
  font: inherit;
  font-size: 0.86rem;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.18s ease, border-color 0.18s ease, background-color 0.18s ease;
}

.choice-btn:hover {
  transform: translateY(-1px);
  border-color: rgba(255, 148, 62, 0.6);
}

.choice-btn.is-active {
  color: #2a1201;
  border-color: rgba(255, 205, 160, 0.75);
  background: linear-gradient(130deg, var(--orange), var(--orange-2));
  box-shadow: 0 0 0 2px rgba(255, 107, 26, 0.16);
}

.menu-link-btn {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  min-height: 38px;
  padding: 8px 14px;
  border-radius: 10px;
  border: 1px solid rgba(255, 148, 62, 0.56);
  background: rgba(255, 148, 62, 0.12);
  color: #ffe4c6;
  text-decoration: none;
  font-size: 0.88rem;
  font-weight: 700;
  width: fit-content;
}

.selected-service-label {
  margin: 0;
  font-size: 0.84rem;
  color: #ceb89f;
}

.selected-service-label.has-value {
  color: #ffd39c;
  font-weight: 700;
}

.product-shop {
  gap: 14px;
  padding-bottom: 10px;
}

.shop-intro {
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  padding: 10px 12px;
  background: rgba(255, 255, 255, 0.03);
}

.shop-intro p {
  margin: 0;
  color: var(--muted);
  font-size: 0.92rem;
}

.modal-body label {
  display: grid;
  gap: 6px;
  font-weight: 700;
}

.modal-body input,
.modal-body select,
.modal-body textarea {
  width: 100%;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 12px;
  padding: 11px 12px;
  color: var(--text);
  background: rgba(255, 255, 255, 0.03);
  font: inherit;
}

.modal-body textarea {
  resize: vertical;
}

.form-error,
.form-success {
  margin: 0;
  min-height: 24px;
  font-weight: 700;
  font-size: 0.92rem;
}

.form-error {
  color: var(--danger);
}

.form-success {
  color: var(--ok);
}

.block {
  width: 100%;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.product-card {
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 16px;
  padding: 11px;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01));
  cursor: pointer;
  display: grid;
  gap: 9px;
  text-align: right;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.product-card figure {
  margin: 0;
  min-height: 98px;
  border-radius: 10px;
  border: 1px dashed rgba(255, 148, 62, 0.52);
  display: grid;
  place-content: center;
  text-align: center;
  background: rgba(255, 107, 26, 0.08);
}

.product-card figure small {
  color: #dacbbb;
  font-size: 0.78rem;
  margin-top: 4px;
}

.product-card strong {
  font-size: 0.98rem;
  font-family: "Changa", sans-serif;
}

.product-card p {
  margin: 0;
  color: var(--muted);
  font-size: 0.82rem;
}

.product-card span {
  color: #ffcf9f;
  font-weight: 700;
}

.product-tag {
  justify-self: start;
  padding: 4px 9px;
  border-radius: 999px;
  border: 1px solid rgba(255, 148, 62, 0.46);
  color: #ffd7ae;
  background: rgba(255, 107, 26, 0.15);
  font-size: 0.74rem;
  font-weight: 700;
}

.product-card.is-selected {
  border-color: rgba(255, 148, 62, 0.78);
  background: linear-gradient(135deg, rgba(255, 107, 26, 0.24), rgba(255, 107, 26, 0.08));
  box-shadow: 0 0 0 3px rgba(255, 107, 26, 0.18);
  transform: translateY(-1px);
}

.shop-bottom-bar {
  position: sticky;
  bottom: 0;
  z-index: 2;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 14px;
  padding: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  background: linear-gradient(165deg, rgba(12, 12, 12, 0.96), rgba(18, 18, 18, 0.96));
}

.shop-total-wrap span {
  display: block;
  color: var(--muted);
  font-size: 0.84rem;
}

.shop-total-wrap strong {
  display: block;
  color: #ffd39c;
  font-size: 1.1rem;
  font-family: "Changa", sans-serif;
}

#products-next {
  min-width: 150px;
}

.hidden {
  display: none;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}

@media (max-width: 900px) {
  .trust-cta-row {
    grid-template-columns: 1fr;
    gap: 12px;
    width: 100%;
    margin-inline: 0;
    justify-self: stretch;
  }

  .cta-zone,
  .product-zone,
  .site-footer {
    flex-direction: column;
    align-items: flex-start;
  }

  .search-wrap {
    max-width: none;
  }
}

@media (max-width: 760px) {
  body {
    padding: 12px;
  }

  .page-shell {
    gap: 12px;
  }

  .site-header {
    flex-direction: column;
    align-items: stretch;
  }

  .tagline-block,
  .hero-box,
  .trust-block,
  .cta-zone,
  .quick-list,
  .site-footer {
    width: 100%;
    margin-inline: auto;
  }

  .hero-placeholder {
    min-height: 240px;
  }

  .trust-main,
  .cta-copy {
    text-align: right;
  }

  .site-footer,
  .footer-meta {
    text-align: center;
  }

  .cta-zone {
    align-items: flex-start;
  }

  .site-footer {
    align-items: center;
  }

  .cta-zone .primary-btn {
    min-width: 140px;
  }

  .trust-metrics {
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .trust-metrics article {
    min-width: 170px;
  }

  .product-grid {
    grid-template-columns: 1fr;
  }

  .shop-bottom-bar {
    flex-direction: column;
    align-items: stretch;
  }

  .hero-box.is-inview .hero-placeholder,
  .trust-block.is-inview,
  .cta-zone.is-inview,
  .quick-list.is-inview {
    animation: none;
    transform: none;
    filter: none;
  }

  .trust-main .stars.trust-zoomed,
  .trust-main h2.trust-zoomed {
    transform: none;
  }

  #products-next {
    width: 100%;
  }

  .footer-meta {
    text-align: right;
  }
}
