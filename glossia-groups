}

.cta-copy {
  text-align: right;
}

.cta-zone .primary-btn {
  min-width: 112px;
  min-height: 26px;
  padding: 6px 9px;
  font-size: 0.56rem;
}

.cta-copy h2,
.product-copy h2 {
  margin: 0;
  font-family: "Changa", sans-serif;
  font-size: clamp(0.6rem, 1.04vw, 0.7rem);
  line-height: 1.35;
}

.cta-copy p,
.product-copy p {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 0.54rem;
}

.primary-btn,
.secondary-btn,
.close-btn {
  border: 0;
  cursor: pointer;
  font-family: inherit;
}

.primary-btn,
.secondary-btn {
  min-width: 190px;
  min-height: 52px;
  padding: 12px 24px;
  border-radius: 999px;
  font-weight: 900;
  font-size: 1rem;
