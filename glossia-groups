}

.tagline-block p {
  margin: 12px 0 0;
  color: var(--muted);
  max-width: 75ch;
  font-size: 0.81rem;
}

.hero-box {
  padding: 12px;
}

.hero-placeholder {
  position: relative;
  overflow: hidden;
  min-height: clamp(270px, 54vw, 550px);
  border-radius: 18px;
  border: 1px dashed rgba(255, 148, 62, 0.45);
  display: grid;
  place-content: center;
  text-align: center;
  gap: 8px;
  background:
    linear-gradient(155deg, rgba(255, 107, 26, 0.16), rgba(255, 107, 26, 0.02)),
    repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0, rgba(255, 255, 255, 0.03) 2px, transparent 2px, transparent 18px);
}

.hero-placeholder span {
  font-size: 2rem;
}

.hero-placeholder strong {
  font-size: 1.2rem;
}

.hero-placeholder small {
  color: var(--muted);
}

.hero-box.is-inview .hero-placeholder {
  animation: hero-panorama-zoom 13s ease-in-out infinite alternate;
}

.trust-block,
.cta-zone,
.quick-list {
  transition: transform 0.8s ease, filter 0.8s ease;
}

.trust-block.is-inview,
.cta-zone.is-inview,
.quick-list.is-inview {
  animation: section-panorama 8s ease-in-out infinite alternate;
}

@keyframes hero-panorama-zoom {
  0% {
    transform: scale(1) translateX(0);
  }
  45% {
    transform: scale(1.05) translateX(-2.2%);
  }
  100% {
    transform: scale(1.1) translateX(2.2%);
  }
}

@keyframes section-panorama {
  0% {
    transform: scale(1);
    filter: brightness(1);
  }
  100% {
    transform: scale(1.02);
    filter: brightness(1.04);
  }
}

.trust-block {
  padding: clamp(10px, 1.8vw, 16px);
  display: grid;
  gap: 9px;
  background:
    radial-gradient(620px 240px at 85% 0%, rgba(255, 107, 26, 0.12), transparent 62%),
    linear-gradient(160deg, var(--surface), var(--surface-2));
}

.trust-main .stars {
  margin: 0 0 4px;
  color: #ffd38f;
  font-size: 0.59rem;
  font-weight: 800;
