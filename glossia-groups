(function () {
  function byId(id) {
    return document.getElementById(id);
  }

  function setActiveButton(activeButton) {
    document.querySelectorAll(".landing-role-btn").forEach(function (button) {
      button.classList.toggle("is-active", button === activeButton);
    });
  }

  function openPanel(panelId, triggerButton) {
    const panels = ["landing-client-panel", "landing-question-panel"];
    panels.forEach(function (id) {
      const panel = byId(id);
      if (!panel) {
        return;
      }

      panel.classList.toggle("hidden", id !== panelId);
    });

    setActiveButton(triggerButton || null);
  }

  document.addEventListener("DOMContentLoaded", function () {
    const personnelButton = byId("landing-personnel-btn");
    const clientButton = byId("landing-client-btn");
    const questionButton = byId("landing-question-btn");

    if (personnelButton) {
      personnelButton.addEventListener("click", function () {
        setActiveButton(personnelButton);
        window.location.href = "personnel-login.html";
      });
    }

    if (clientButton) {
      clientButton.addEventListener("click", function () {
        openPanel("landing-client-panel", clientButton);
      });
    }

    if (questionButton) {
      questionButton.addEventListener("click", function () {
        openPanel("landing-question-panel", questionButton);
      });
    }

    document.querySelectorAll("[data-close-panel]").forEach(function (button) {
      button.addEventListener("click", function () {
        const panelId = button.getAttribute("data-close-panel");
        const panel = byId(panelId || "");
        if (!panel) {
          return;
        }

        panel.classList.add("hidden");
        setActiveButton(null);
      });
    });
  });
})();

@import url("https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap");

:root {
  --bg: #0a0a0a;
  --bg-soft: #111111;
  --surface: rgba(17, 17, 17, 0.88);
  --surface-strong: rgba(10, 10, 10, 0.94);
